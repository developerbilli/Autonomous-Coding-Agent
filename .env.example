# ============================================================
# LangSmith Observability & Tracing Configuration
# ============================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT=autonomous-coding-agent

# ============================================================
# LLM Provider Credentials
# ============================================================
# Google Gemini (Primary Default)
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI (Optional / Fallback)
OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic (Optional)
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# ============================================================
# Environment & Deployment Mode
# ============================================================
# development | production
# In production, Tier 4 host-process fallback is strictly prohibited.
# The agent fails closed if strong container/microVM isolation is offline.
ENVIRONMENT=development

# ============================================================
# Sandbox Security Configuration
# ============================================================
# Authorize Tier 4 host-process fallback ONLY on local developer machines
# when strong isolation (Docker / gVisor / Firecracker) is not running.
# In production, set to 0 to enforce strict fail-closed security.
ALLOW_UNSAFE_HOST_FALLBACK=0

